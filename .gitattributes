# Normalize text files in Git
* text=auto

# Repository source/configuration files
*.py      text eol=lf
*.md      text eol=lf
*.txt     text eol=lf
*.csv     text eol=lf
*.toml    text eol=lf
*.yaml    text eol=lf
*.yml     text eol=lf
*.json    text eol=lf
*.cff     text eol=lf
*.gitignore text eol=lf

# Binary documents / images
*.pdf binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.pptx binary
*.docx binary
# ------------------------------------------------------------
# Historical provenance snapshots
# ------------------------------------------------------------
# Preserve the exact byte representation of historical source files.
# These files intentionally retain their original CRLF line endings
# because their SHA-256 hashes are part of the provenance record.
reference_implementations/published_pipeline/*.py -text -eol
