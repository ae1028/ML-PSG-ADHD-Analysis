# Normalize text files in Git
* text=auto

# Repository source/configuration files
*.py      text eol=lf
*.md      text eol=lf
*.txt     text eol=lf
*.csv     text eol=lf
*.toml    text eol=lf
*.yaml    text eol=lf
*.yml     text eol=lf
*.json    text eol=lf
*.cff     text eol=lf
*.gitignore text eol=lf

# Binary documents / images
*.pdf binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.pptx binary
*.docx binary